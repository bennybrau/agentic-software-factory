{
  "name": "agentic-software-factory",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "dev:api": "pnpm --filter @asf/api dev",
    "dev:registry": "pnpm --filter @asf/registry dev",
    "dev:worker": "pnpm --filter @asf/worker dev",
    "dev:web": "pnpm --filter @asf/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "dev": "node scripts/dev.mjs",
    "dev:mock": "node scripts/dev.mjs --no-worker",
    "gen:config": "node scripts/gen-config-docs.mjs",
    "gen:config:check": "node scripts/gen-config-docs.mjs --check",
    "asf": "scripts/asf"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  }
}
