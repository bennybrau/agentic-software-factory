#!/usr/bin/env bash
#
# asf — day-2 CLI for the self-hosted factory. One portable entry point over
# `docker compose -f docker-compose.self-host.yml` (project "asf"), so operators
# never type a compose command.
#
#   asf up | down | restart [svc] | logs [svc] [-f] | status
#   asf doctor            # read-only health table
#   asf update            # git pull --ff-only, rebuild, wait healthy
#   asf backup            # immediate pg_dump into the backups volume + ./backups
#   asf restore <file>    # load a dump back in
#   asf reset --yes       # DESTROY all data (down -v)
#   asf uninstall         # remove the whole install so setup.sh starts fresh
#   asf open              # open the UI in a browser
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT"

# shellcheck source=scripts/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

ENV_FILE="$ROOT/.env"
BACKUP_DIR="$ROOT/backups"

# Host-worker mode (ASF_MODE=2): the worker runs on this host under launchd/systemd
# (scripts/host-worker.sh), not in a container. Layer the overlay that publishes the
# registry on loopback (so the host worker can reach it) and disables the container
# worker, and route worker up/down/status/logs to the host supervisor.
HOST_WORKER_MODE=0
HOST_WORKER="$SCRIPT_DIR/host-worker.sh"
COMPOSE_FILES=(-f "$COMPOSE_FILE")
COMPOSE_ARG="-f $COMPOSE_FILE"   # for the hints we print
if [ "$(read_env_key "$ENV_FILE" ASF_MODE)" = "2" ]; then
  HOST_WORKER_MODE=1
  HOST_WORKER_OVERLAY="$ROOT/docker-compose.host-worker.yml"
  COMPOSE_FILES+=(-f "$HOST_WORKER_OVERLAY")
  COMPOSE_ARG="$COMPOSE_ARG -f docker-compose.host-worker.yml"
fi
# Linux: map host.docker.internal for the api and worker (see host_gateway_on).
HOST_GATEWAY=0
if host_gateway_on "$ENV_FILE"; then
  HOST_GATEWAY=1
  COMPOSE_FILES+=(-f "$ROOT/docker-compose.host-gateway.yml")
  COMPOSE_ARG="$COMPOSE_ARG -f docker-compose.host-gateway.yml"
fi
# A scratch Postgres for the agents' tests (see test_db_on).
TEST_DB=0
if test_db_on "$ENV_FILE"; then
  TEST_DB=1
  COMPOSE_FILES+=(-f "$ROOT/docker-compose.testdb.yml")
  COMPOSE_ARG="$COMPOSE_ARG -f docker-compose.testdb.yml"
fi
compose() { docker compose "${COMPOSE_FILES[@]}" "$@"; }

usage() {
  cat <<'EOF'
asf — manage the self-hosted factory.

Usage: scripts/asf <command> [args]

  up                 build (if needed) and start the stack, restart-always
  down               stop the stack (volumes kept)
  restart [svc]      restart the whole stack, or one service
  logs [svc] [-f]    show logs (all services or one); -f to follow
  status             docker compose ps
  doctor             read-only health check (✓/✗/⚠), exit 0 only if all ✓
  update             pull prebuilt images and restart, wait healthy
                     (--from-source: git pull --ff-only + rebuild locally)
  backup             immediate pg_dump into the backups volume and ./backups
  restore <file>     restore the database from a .sql.gz dump
  secret-key         add ASF_SECRET_KEY to .env and encrypt saved tokens
                     (--rotate: move every saved token to a fresh key)
  reset --yes        DESTROY all data and volumes (double-confirmed)
  uninstall [opts]   remove the whole install (stack, data, host worker, .env) so
                     scripts/setup.sh starts fresh; see scripts/uninstall.sh --help
  open               open the UI in a browser
  help               this help
EOF
}

# --- port / url -------------------------------------------------------------
asf_port() { local p; p="$(read_env_key "$ENV_FILE" ASF_PORT)"; printf '%s' "${p:-8787}"; }
ui_url()   { printf 'http://localhost:%s' "$(asf_port)"; }

# --- fetch a URL from inside a container (images have node, not curl) --------
node_fetch() { # $1 = service, $2 = url ; body -> stdout, exit 0 iff HTTP ok
  compose exec -T "$1" node -e '
    fetch(process.argv[1]).then(async r => {
      const t = await r.text();
      process.stdout.write(t);
      process.exit(r.ok ? 0 : 1);
    }).catch(e => { process.stderr.write(String((e && e.message) || e)); process.exit(2); });
  ' "$2" 2>/dev/null
}

# Fetch an api JSON route and extract a summary line with a JS body over `j`.
# The api routes are identity-gated; AUTH_MODE=none resolves the default identity,
# so no auth header is needed. Runs inside the api container.
api_check() { # $1 = path, $2 = js body returning a string ; prints result
  compose exec -T api node -e '
    const path = process.argv[1];
    const extract = new Function("j", process.argv[2]);
    fetch("http://127.0.0.1:8787" + path)
      .then(r => r.json())
      .then(j => { process.stdout.write(String(extract(j))); })
      .catch(e => { process.stdout.write("ERR|" + ((e && e.message) || e)); process.exit(1); });
  ' "$1" "$2" 2>/dev/null || true
}

# Saved-token encryption state from the registry's /health (#9), as
# "state|keyId|total|plaintext|undecryptable"; "ERR|..." when unreachable.
secrets_status() {
  compose exec -T registry node -e '
    fetch("http://127.0.0.1:8788/health").then(r => r.json()).then(j => {
      const s = j.secrets;
      process.stdout.write(s ? [s.state, s.keyId || "", s.total, s.plaintext, s.undecryptable].join("|") : "ERR|no secrets field (registry older than #9?)");
    }).catch(e => { process.stdout.write("ERR|" + ((e && e.message) || e)); });
  ' 2>/dev/null || printf 'ERR|registry not reachable'
}

# Key fingerprints (#9) without the registry: the 8-hex keyId the registry stamps
# on each envelope = sha256("asf-org-secret-key-id:" || key bytes). Blank when the
# key is unset or not hex (setup and secret-key always write hex).
env_key_id() { # $1 = .env key
  local hex; hex="$(read_env_key "$ENV_FILE" "$1" 2>/dev/null || true)"
  printf '%s' "$hex" | grep -Eq '^[0-9a-fA-F]{64}$' || return 0
  command -v openssl >/dev/null 2>&1 || return 0
  { printf 'asf-org-secret-key-id:'; printf "$(printf '%s' "$hex" | sed 's/../\\x&/g')"; } \
    | openssl dgst -sha256 2>/dev/null | sed 's/^.*= *//' | cut -c1-8
}

# The distinct keyIds the saved tokens in a dump were encrypted with (blank for
# a dump with none: pre-#9, no key, or no saved tokens).
dump_key_ids() { # $1 = .sql.gz
  { gunzip -c "$1" 2>/dev/null || true; } | { grep -o 'enc:v1:[0-9a-f]\{8\}:' || true; } \
    | cut -d: -f3 | sort -u | tr '\n' ' ' | sed 's/ $//'
}

# --- subcommands ------------------------------------------------------------
cmd_up() {
  compose up -d --build
  # Host-worker mode (ASF_MODE=2): the container worker is disabled; start the one
  # supervised on this host instead.
  if [ "$HOST_WORKER_MODE" -eq 1 ]; then
    info "mode 2: starting the host worker"
    "$HOST_WORKER" up || warn "host-worker launcher failed" "run it directly: $HOST_WORKER up"
  fi
  info "UI: $(ui_url)"
}

cmd_down() {
  # `asf down worker` in mode 2 only stops the host worker; a bare `asf down`
  # stops the stack and the host worker together.
  if [ "$HOST_WORKER_MODE" -eq 1 ] && [ "${1:-}" = "worker" ]; then
    "$HOST_WORKER" down; return
  fi
  compose down
  [ "$HOST_WORKER_MODE" -eq 1 ] && { "$HOST_WORKER" down || true; }
}

cmd_restart() {
  if [ "$HOST_WORKER_MODE" -eq 1 ] && [ "${1:-}" = "worker" ]; then
    "$HOST_WORKER" up; return   # kickstart -k / systemctl restart
  fi
  if [ -n "${1:-}" ]; then compose restart "$1"; else compose restart; fi
}

cmd_status() {
  if [ "$HOST_WORKER_MODE" -eq 1 ] && [ "${1:-}" = "worker" ]; then
    "$HOST_WORKER" status; return
  fi
  compose ps
}

cmd_logs() {
  local follow=0 svcs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--follow) follow=1; shift ;;
      *) svcs+=("$1"); shift ;;
    esac
  done
  # `asf logs worker` in mode 2 tails the host worker log (there is no container).
  if [ "$HOST_WORKER_MODE" -eq 1 ] && [ "${#svcs[@]}" -eq 1 ] && [ "${svcs[0]}" = "worker" ]; then
    if [ "$follow" -eq 1 ]; then "$HOST_WORKER" logs -f; else "$HOST_WORKER" logs; fi
    return
  fi
  if [ "$follow" -eq 1 ]; then
    compose logs -f --tail=100 "${svcs[@]}"
  else
    compose logs --tail=200 "${svcs[@]}"
  fi
}

cmd_open() {
  local url; url="$(ui_url)"
  if command -v open >/dev/null 2>&1; then open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url"
  else info "open this in your browser: $url"; fi
}

cmd_update() {
  local from_source=0
  case "${1:-}" in
    --from-source|--build) from_source=1 ;;
    "") ;;
    *) die "unknown update option: $1 (use --from-source to rebuild locally)" ;;
  esac
  section "Updating"
  if [ "$from_source" -eq 1 ]; then
    [ -z "$(git status --porcelain 2>/dev/null)" ] || die "working tree is dirty — commit or stash before updating"
    info "git pull --ff-only"
    git pull --ff-only
    info "docker compose up -d --build"
    compose up -d --build
  else
    # Default: pull the prebuilt images (pinned by ASF_VERSION, else :latest) and
    # restart with no local build. Use --from-source to build from this checkout.
    info "docker compose pull"
    compose pull
    info "docker compose up -d"
    compose up -d
  fi
  section "Health"
  wait_healthy postgres postgres 120 || true
  wait_healthy registry registry 180 || true
  wait_healthy api api 180 || true
  # Migration count: the registry logs {"applied":N,"total":M} at boot.
  local line count
  line="$(compose logs --tail=500 registry 2>/dev/null | grep -o '"total":[0-9]*' | tail -1 || true)"
  count="${line#*:}"
  if [ -n "$count" ]; then ok "registry migrations applied: schema at ${count} migration(s)"
  else warn "could not read the migration count from the registry log" "check: asf logs registry"; fi
}

cmd_backup() {
  section "Backup"
  local ts name remote
  ts="$(date +%Y%m%d-%H%M%S)"
  name="asf-manual-${ts}.sql.gz"
  remote="/backups/${name}"
  # The backup container already carries PGPASSWORD and reaches postgres over the
  # compose network; write into the shared backups volume, then copy to the host.
  compose exec -T backup sh -c "pg_dump -h postgres -U asf asf | gzip > '${remote}'" \
    || die "pg_dump failed — is the stack up? (asf status)"
  mkdir -p "$BACKUP_DIR"
  compose cp "backup:${remote}" "$BACKUP_DIR/${name}"
  ok "wrote ${remote} (backups volume)"
  ok "copied to ${BACKUP_DIR}/${name}"
  local st; st="$(secrets_status)"
  case "${st%%|*}" in
    encrypted) info "saved tokens in this dump are encrypted with ASF_SECRET_KEY (key $(printf '%s' "$st" | cut -d'|' -f2))."
               info "keep a copy of .env (ASF_SECRET_KEY) apart from your backups: without it a restore loses the tokens." ;;
    plaintext|key-mismatch) warn "this dump holds saved tokens that are not encrypted with the current key — treat the file as a secret" "asf secret-key" ;;
  esac
}

cmd_restore() {
  local file="${1:-}"
  [ -n "$file" ] || die "usage: asf restore <file.sql.gz>"
  [ -f "$file" ] || die "no such file: $file"
  # Saved tokens (#9): which key(s) the dump's tokens were encrypted with, vs the
  # key this stack has now. Checked BEFORE anything is dropped.
  gunzip -t "$file" 2>/dev/null || die "${file} is not a readable .sql.gz"
  local dump_keys have_keys missing="" k
  dump_keys="$(dump_key_ids "$file")"
  have_keys="$(env_key_id ASF_SECRET_KEY) $(env_key_id ASF_SECRET_KEY_PREVIOUS)"
  for k in $dump_keys; do
    case " $have_keys " in *" $k "*) ;; *) missing="${missing:+$missing }$k" ;; esac
  done
  if [ -n "$missing" ]; then
    warn "the dump has saved tokens encrypted with key ${missing}, which is not the ASF_SECRET_KEY in .env (key $(env_key_id ASF_SECRET_KEY | sed 's/^$/not set/'))" \
      "put that key in .env as ASF_SECRET_KEY (or ASF_SECRET_KEY_PREVIOUS) first, or re-enter the tokens in Settings after the restore"
    confirm "Restore anyway? Those saved tokens will be unreadable until the matching key is in .env." \
      || { info "aborted"; return 0; }
  fi
  confirm "Restore the database from ${file}? This REPLACES all current data." \
    || { info "aborted"; return 0; }
  section "Restore"
  # Only the registry connects to Postgres; stop the whole app tier so nothing
  # touches the database while we drop and reload the schema.
  info "stopping api, worker and registry"
  compose stop api worker registry
  info "resetting the schema"
  compose exec -T backup sh -c 'psql -h postgres -U asf -d asf -v ON_ERROR_STOP=1 -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"'
  info "loading ${file}"
  gunzip -c "$file" | compose exec -T backup sh -c 'psql -h postgres -U asf -d asf -q'
  info "restarting the stack"
  compose up -d
  wait_healthy registry "registry" 120 || return 1
  local st; st="$(secrets_status)"
  case "${st%%|*}" in
    key-mismatch) bad "restored, but $(printf '%s' "$st" | cut -d'|' -f5) saved token(s) can't be decrypted with ASF_SECRET_KEY" \
                    "put the key they were saved with in .env as ASF_SECRET_KEY (or ASF_SECRET_KEY_PREVIOUS), then asf restart registry; or re-enter them in Settings"
                  return 1 ;;
    plaintext)    warn "restored; saved tokens are in plaintext" "asf secret-key" ;;
  esac
  ok "restore complete"
}

# Saved-token encryption (#9). Adds ASF_SECRET_KEY to .env (never replaces one)
# and recreates the registry, which encrypts every saved token at boot.
# --rotate: the current key becomes ASF_SECRET_KEY_PREVIOUS, a fresh key becomes
# current, the registry re-encrypts, and the old key is dropped from .env only
# after the registry has proven every token opens with the new key alone.
cmd_secret_key() {
  section "Saved-token encryption key"
  [ -f "$ENV_FILE" ] || die ".env missing — run scripts/setup.sh"
  local rotate=0 cur prev st
  [ "${1:-}" = "--rotate" ] && rotate=1
  cur="$(read_env_key "$ENV_FILE" ASF_SECRET_KEY)"
  prev="$(read_env_key "$ENV_FILE" ASF_SECRET_KEY_PREVIOUS)"
  if [ "$rotate" -eq 1 ]; then
    [ -n "$cur" ] || die "no ASF_SECRET_KEY to rotate — run asf secret-key first"
    [ -z "$prev" ] || die "ASF_SECRET_KEY_PREVIOUS is already set (an unfinished rotation?) — check asf doctor, then remove it from .env"
    st="$(secrets_status)"
    [ "${st%%|*}" != "key-mismatch" ] || die "some saved tokens already can't be decrypted — fix that first (asf doctor)"
    cp "$ENV_FILE" "$ENV_FILE.bak"; chmod 600 "$ENV_FILE.bak"
    set_env_key "$ENV_FILE" ASF_SECRET_KEY_PREVIOUS "$cur"
    set_env_key "$ENV_FILE" ASF_SECRET_KEY "$(rand_hex 32)"
    ok "new ASF_SECRET_KEY written; the old key is ASF_SECRET_KEY_PREVIOUS until every token is moved (.env.bak has the old .env)"
  elif [ -n "$cur" ]; then
    ok "ASF_SECRET_KEY already set in .env — keeping it (use --rotate for a new key)"
  else
    set_env_key "$ENV_FILE" ASF_SECRET_KEY "$(rand_hex 32)"
    ok "added ASF_SECRET_KEY to .env"
  fi
  chmod 600 "$ENV_FILE"

  info "recreating the registry so it picks up the key (runs keep going)"
  compose up -d --no-deps registry >/dev/null 2>&1 || die "could not recreate the registry (asf logs registry)"
  wait_healthy registry "registry" 120 || return 1
  st="$(secrets_status)"
  if [ "$rotate" -eq 1 ]; then
    if [ "${st%%|*}" != "encrypted" ] && [ "${st%%|*}" != "none" ]; then
      bad "rotation did not finish: saved tokens are ${st%%|*}" "asf logs registry; .env still has both keys, nothing is lost"
      return 1
    fi
    set_env_key "$ENV_FILE" ASF_SECRET_KEY_PREVIOUS ""
    compose up -d --no-deps registry >/dev/null 2>&1 || die "could not recreate the registry (asf logs registry)"
    wait_healthy registry "registry" 120 || return 1
    st="$(secrets_status)"
    if [ "${st%%|*}" != "encrypted" ] && [ "${st%%|*}" != "none" ]; then
      set_env_key "$ENV_FILE" ASF_SECRET_KEY_PREVIOUS "$cur"
      compose up -d --no-deps registry >/dev/null 2>&1 || true
      bad "some tokens still need the old key — put it back as ASF_SECRET_KEY_PREVIOUS" "asf logs registry"
      return 1
    fi
    ok "every saved token is on the new key; ASF_SECRET_KEY_PREVIOUS removed"
  fi
  case "${st%%|*}" in
    encrypted)    ok "saved tokens: $(printf '%s' "$st" | cut -d'|' -f3) encrypted at rest (key $(printf '%s' "$st" | cut -d'|' -f2))" ;;
    none)         ok "no saved tokens yet; new ones will be encrypted (key $(printf '%s' "$st" | cut -d'|' -f2))" ;;
    key-mismatch) bad "$(printf '%s' "$st" | cut -d'|' -f5) saved token(s) can't be decrypted with this key" \
                    "they were saved under a different key: restore it as ASF_SECRET_KEY_PREVIOUS, or re-enter them in Settings"
                  return 1 ;;
    *)            warn "could not confirm the saved-token state: ${st#*|}" "asf doctor" ;;
  esac
  info "back up .env (it holds ASF_SECRET_KEY) apart from your database backups."
}

cmd_reset() {
  [ "${1:-}" = "--yes" ] || die "reset destroys all data — pass --yes to proceed"
  confirm "This DELETES ALL DATA (pgdata, worktrees, runs, backups). Continue?" \
    || { info "aborted"; return 0; }
  confirm "Are you absolutely sure? This cannot be undone." \
    || { info "aborted"; return 0; }
  compose down -v
  ok "stack down and all volumes removed"
}

# --- Ollama (M11 WP7, docs/OLLAMA.md) ------------------------------------------
version_ge() { # $1 >= $2, dotted numbers ("0.40.4" >= "0.14.0")
  local a b i x y
  IFS=. read -r -a a <<< "$1"; IFS=. read -r -a b <<< "$2"
  for i in 0 1 2; do
    x="${a[$i]:-0}"; y="${b[$i]:-0}"; x="${x%%[!0-9]*}"; y="${y%%[!0-9]*}"
    [ "${x:-0}" -gt "${y:-0}" ] && return 0
    [ "${x:-0}" -lt "${y:-0}" ] && return 1
  done
  return 0
}
OLLAMA_MIN_VERSION=0.14.0     # packages/shared/src/ollama.ts
OLLAMA_MIN_CONTEXT=64000

# GET a URL from this host (curl), body -> stdout; exit 3 when curl is missing.
host_fetch() { command -v curl >/dev/null 2>&1 || return 3; curl -fsS -m 5 "$1" 2>/dev/null; }

# Where the Ollama server is probed from: the worker container (or this host in mode 2).
# When the worker container isn't running, doctor_ollama falls back to the api's.
OLLAMA_PROBE=worker
ollama_from_worker() { # $1 = url
  if [ "$HOST_WORKER_MODE" -eq 1 ]; then host_fetch "$1"; else node_fetch "$OLLAMA_PROBE" "$1"; fi
}

doctor_ollama() {
  section "Ollama"
  local res rest key url body ver ps min hurl where
  res="$(api_check /api/settings 'const s=Object.fromEntries((j.settings||[]).map(x=>[x.key,x])); const k=(s.OLLAMA_API_KEY||{}).value; return "OK|"+(k?"1":"0")+"|"+((s.OLLAMA_BASE_URL||{}).value||"")')"
  if [ "${res%%|*}" != "OK" ]; then warn "Ollama settings not readable" "is the api up? asf logs api"; return 0; fi
  rest="${res#OK|}"; key="${rest%%|*}"; url="${rest#*|}"; url="${url%/}"
  if [ -z "$url" ] && [ "$key" != "1" ]; then
    info "not set up (optional: free models on your own machine or Ollama Cloud, docs/OLLAMA.md)"
    return 0
  fi
  [ "$key" = "1" ] && ok "Ollama Cloud key saved (sent only to https://ollama.com)"
  [ -z "$url" ] && return 0

  [ "$HOST_GATEWAY" -eq 1 ] && info "host.docker.internal is mapped to this host (docker-compose.host-gateway.yml)"
  if [ "$HOST_WORKER_MODE" -ne 1 ]; then
    case "$url" in
      *://localhost*|*://127.*|*://\[::1\]*|*://0.0.0.0*)
        bad "OLLAMA_BASE_URL is ${url}: inside a container that is the container itself, not this machine" \
          "use http://host.docker.internal:11434 (Settings → Use free models with Ollama?)"
        return 0 ;;
    esac
  fi

  OLLAMA_PROBE=worker; where="the worker"
  if [ "$HOST_WORKER_MODE" -eq 1 ]; then
    where="this host (the worker runs here)"
  else
    case "$(container_health worker)" in
      healthy|running|starting) ;;
      *) OLLAMA_PROBE=api; where="the api container"
         info "the worker container isn't running (see Containers), so this checks from the api container, on the same network" ;;
    esac
  fi
  if body="$(ollama_from_worker "$url/api/version")"; then
    ver="$(printf '%s' "$body" | sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p')"
    if [ -z "$ver" ]; then
      bad "${url} answered from ${where}, but not like an Ollama server" "check the address and port in Settings → Use free models with Ollama?"
      return 0
    elif version_ge "$ver" "$OLLAMA_MIN_VERSION"; then
      ok "server ${url} reachable from ${where}: Ollama ${ver}"
    else
      bad "Ollama ${ver} at ${url} is too old: ASF needs ${OLLAMA_MIN_VERSION} or later" "update Ollama on that machine (https://ollama.com/download)"
      return 0
    fi
  else
    # Say whether it's down, or up but out of the container's reach.
    hurl="$(printf '%s' "$url" | sed 's#://host\.docker\.internal#://127.0.0.1#')"
    if [ "$HOST_WORKER_MODE" -ne 1 ] && [ "$hurl" != "$url" ] && host_fetch "$hurl/api/version" >/dev/null; then
      if [ "$(uname -s)" = "Linux" ] && [ "$HOST_GATEWAY" -ne 1 ]; then
        bad "Ollama answers on this host but not from the ${OLLAMA_PROBE} container" "set ASF_HOST_GATEWAY=1 in .env (or remove ASF_HOST_GATEWAY=0), then asf up"
      else
        bad "Ollama answers on this host but not from the ${OLLAMA_PROBE} container" \
          "make it listen on every interface: OLLAMA_HOST=0.0.0.0 (docs/OLLAMA.md), then restart Ollama"
      fi
    else
      warn "Ollama server ${url} not reachable from ${where}" "start Ollama (jobs on local Ollama models wait until it is up); docs/OLLAMA.md"
    fi
    return 0
  fi

  # Settings lists and checks models from the api container.
  if [ "$HOST_WORKER_MODE" -ne 1 ] && [ "$OLLAMA_PROBE" = worker ] && ! node_fetch api "$url/api/version" >/dev/null; then
    warn "the api container can't reach ${url}: Settings can't list or check its models" "asf up (re-applies the compose files), then asf doctor"
  fi

  # The context the server really loaded (only visible while a model is loaded).
  ps="$(ollama_from_worker "$url/api/ps" || true)"
  min="$(printf '%s' "$ps" | grep -o '"context_length" *: *[0-9]*' | grep -o '[0-9]*$' | sort -n | head -1 || true)"
  if [ -z "$min" ]; then
    info "context: no model loaded right now (Settings' model check measures it)"
  elif [ "$min" -ge "$OLLAMA_MIN_CONTEXT" ]; then
    ok "context: loaded model runs with ${min} tokens"
  else
    warn "context: a loaded model runs with only ${min} tokens; jobs need ${OLLAMA_MIN_CONTEXT}" \
      "start Ollama with OLLAMA_CONTEXT_LENGTH=65536 (docs/OLLAMA.md), then restart it"
  fi
}

cmd_doctor() {
  DOCTOR_FAIL=0
  DOCTOR_WARN=0

  section "Host"
  local docker_ok=0
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    ok "docker daemon reachable"; docker_ok=1
  else
    bad "docker daemon not reachable" "start Docker Desktop / the docker service"
  fi
  if docker compose version >/dev/null 2>&1; then
    ok "docker compose v2 ($(docker compose version --short 2>/dev/null || echo present))"
  else
    bad "docker compose v2 not available" "install the Compose v2 plugin"
  fi

  local disk_dir avail_kb avail_gb
  disk_dir="$HOME"
  [ "$docker_ok" -eq 1 ] && disk_dir="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo "$HOME")"
  [ -d "$disk_dir" ] || disk_dir="$ROOT"
  avail_kb="$(df -Pk "$disk_dir" 2>/dev/null | awk 'NR==2 {print $4}')"
  if [ -n "$avail_kb" ]; then
    avail_gb=$((avail_kb / 1024 / 1024))
    if [ "$avail_gb" -ge 10 ]; then ok "disk: ${avail_gb} GB free (${disk_dir})"
    else warn "disk: only ${avail_gb} GB free (${disk_dir})" "free up space; images + Postgres need >= 10 GB"; fi
  else
    warn "could not measure free disk at ${disk_dir}" "make sure >= 10 GB is available"
  fi

  section "Configuration (.env)"
  if [ ! -f "$ENV_FILE" ]; then
    bad ".env missing" "run scripts/setup.sh to generate it"
  else
    local perm secret
    perm="$(stat -c '%a' "$ENV_FILE" 2>/dev/null || stat -f '%Lp' "$ENV_FILE" 2>/dev/null || echo '?')"
    if [ "$perm" = "600" ]; then ok ".env present (chmod 600)"
    else warn ".env is chmod ${perm} (want 600)" "chmod 600 .env"; fi
    secret="$(read_env_key "$ENV_FILE" RUN_EVENT_SECRET)"
    case "$secret" in
      "")       bad "RUN_EVENT_SECRET is empty" "set it in .env: openssl rand -hex 32" ;;
      *"***"*)  bad "RUN_EVENT_SECRET looks masked (contains ***)" "paste the real secret into .env" ;;
      *"#"*)    warn "RUN_EVENT_SECRET has an inline '#' — env_file keeps it literally" "remove the trailing comment from the line" ;;
      *)        ok "RUN_EVENT_SECRET set" ;;
    esac
    case "$(read_env_key "$ENV_FILE" ASF_SECRET_KEY)" in
      "")       warn "ASF_SECRET_KEY is empty: tokens saved in Settings are stored in plaintext" "asf secret-key" ;;
      *"***"*)  bad "ASF_SECRET_KEY looks masked (contains ***)" "paste the real key into .env" ;;
      *)        ok "ASF_SECRET_KEY set (saved tokens encrypted at rest)" ;;
    esac
  fi

  if [ "$docker_ok" -ne 1 ]; then
    doctor_summary
    return
  fi

  section "Containers"
  local svc status container_svcs="postgres registry api worker backup"
  # In host-worker mode the container worker is intentionally not running.
  [ "$HOST_WORKER_MODE" -eq 1 ] && container_svcs="postgres registry api backup"
  # The agents' scratch test database (ASF_TEST_DB=1, docker-compose.testdb.yml).
  [ "$TEST_DB" -eq 1 ] && container_svcs="$container_svcs testdb"
  if [ "$HOST_WORKER_MODE" -eq 1 ] && [ "$(env_flag "$ENV_FILE" ASF_TEST_DB)" = 1 ]; then
    info "ASF_TEST_DB is ignored in host-worker mode: the host worker can't reach the container database (docs/SELF_HOSTING.md)"
  fi
  for svc in $container_svcs; do
    status="$(container_health "$svc")"
    case "$status" in
      healthy|running) ok "${svc}: ${status}" ;;
      starting)        warn "${svc}: starting" "give it a moment, then re-run doctor" ;;
      missing)         bad "${svc}: not running" "asf up" ;;
      *)               bad "${svc}: ${status}" "asf logs ${svc}" ;;
    esac
  done

  section "Version"
  local want cid img tag svcimg
  want="$(read_env_key "$ENV_FILE" ASF_VERSION)"; want="${want:-latest}"
  info "ASF_VERSION: ${want}"
  local ver_svcs="registry api worker"
  [ "$HOST_WORKER_MODE" -eq 1 ] && ver_svcs="registry api"
  for svc in $ver_svcs; do
    cid="$(compose ps -q "$svc" 2>/dev/null || true)"
    if [ -z "$cid" ]; then warn "${svc}: not running" "asf up"; continue; fi
    img="$(docker inspect --format '{{.Config.Image}}' "$cid" 2>/dev/null || true)"
    tag="${img##*:}"; [ "$tag" = "$img" ] && tag="latest"
    svcimg="${img%%:*}"
    case "$svcimg" in
      ghcr.io/*)
        if [ "$tag" = "$want" ]; then ok "${svc}: ${tag}"
        else warn "${svc}: running ${tag}, ASF_VERSION=${want}" "asf update to pull ${want}"; fi ;;
      *) info "${svc}: locally built (${img})" ;;
    esac
  done

  section "Services"
  if node_fetch registry http://127.0.0.1:8788/health >/dev/null 2>&1; then ok "registry /health ok"
  else bad "registry /health failed" "asf logs registry"; fi
  if node_fetch api http://127.0.0.1:8787/health >/dev/null 2>&1; then ok "api /health ok"
  else bad "api /health failed" "asf logs api"; fi
  local sst stotal
  sst="$(secrets_status)"; stotal="$(printf '%s' "$sst" | cut -d'|' -f3)"
  case "${sst%%|*}" in
    none)         ok "saved tokens: none yet" ;;
    encrypted)    ok "saved tokens: ${stotal} encrypted at rest (key $(printf '%s' "$sst" | cut -d'|' -f2))"
                  [ -n "$(read_env_key "$ENV_FILE" ASF_SECRET_KEY_PREVIOUS)" ] && info "ASF_SECRET_KEY_PREVIOUS can be removed from .env (every token is on the new key)" ;;
    plaintext)    warn "saved tokens: $(printf '%s' "$sst" | cut -d'|' -f4) of ${stotal} stored in PLAINTEXT" \
                    "asf secret-key (or, if ASF_SECRET_KEY is already set: asf restart registry)" ;;
    key-mismatch) bad "saved tokens: $(printf '%s' "$sst" | cut -d'|' -f5) of ${stotal} can't be decrypted with ASF_SECRET_KEY (key $(printf '%s' "$sst" | cut -d'|' -f2))" \
                    "put the key they were saved with in .env (as ASF_SECRET_KEY or ASF_SECRET_KEY_PREVIOUS), then asf restart registry; or re-enter them in Settings" ;;
    *)            warn "saved tokens: state unknown (${sst#*|})" "asf logs registry" ;;
  esac

  section "Providers"
  local res kind rest
  res="$(api_check /api/providers/ticket/preflight 'return j.ok ? ("OK|"+(j.kind||"?")+"|"+(j.identity||"")) : ("FAIL|"+(j.reason||"unknown"))')"
  kind="${res%%|*}"; rest="${res#*|}"
  case "$kind" in
    OK)   ok "ticket provider (${rest%%|*}) — ${rest#*|}" ;;
    FAIL) bad "ticket provider preflight failed: ${rest}" "set the provider + credential in the web UI (Settings)" ;;
    *)    warn "ticket provider not reachable" "is the api up? asf logs api" ;;
  esac
  res="$(api_check /api/providers/scm/preflight 'return j.ok ? ("OK|"+(j.kind||"?")+"|"+(j.identity||"")) : ("FAIL|"+(j.reason||"unknown"))')"
  kind="${res%%|*}"; rest="${res#*|}"
  case "$kind" in
    OK)   ok "SCM provider (${rest%%|*}) — ${rest#*|}" ;;
    FAIL) bad "SCM provider preflight failed: ${rest}" "set the provider + credential in the web UI (Settings)" ;;
    *)    warn "SCM provider not reachable" "is the api up? asf logs api" ;;
  esac

  section "Fleet"
  res="$(api_check /api/fleet 'const w=j.workers||[]; if(!w.length) return "NONE"; const rt=[...new Set(w.flatMap(x=>x.runtimes||[]))].join(","); return "OK|"+w.length+"|"+(rt||"none")+"|"+(j.running||0)+"/"+(j.capacity||0)')"
  kind="${res%%|*}"; rest="${res#*|}"
  case "$kind" in
    OK)   ok "workers: ${rest%%|*} live, runtimes [$(printf '%s' "$rest" | cut -d'|' -f2)], running $(printf '%s' "$rest" | cut -d'|' -f3)" ;;
    NONE) bad "no live workers" "start one: asf up (or the host worker in mode 2)" ;;
    *)    warn "fleet not reachable" "is the api up? asf logs api" ;;
  esac

  # Read the setup-status item, not /api/agent-auth: that route is worker-only
  # (X-Run-Secret), so asking it here got a 401 body that read as "no credential".
  res="$(api_check /api/setup/status 'const i=(j.items||[]).find(x=>x.id==="agent-auth"); if(!i) return "ERR|"+(j.error||"no agent-auth item"); return (i.done ? "OK|" : "WARN|") + (i.reason||"")')"
  kind="${res%%|*}"; rest="${res#*|}"
  case "$kind" in
    OK)   ok "agent auth: ${rest}" ;;
    WARN) warn "agent auth: ${rest}" "add the credential in the web UI (Settings → Which AI should do the work?)" ;;
    *)    warn "agent auth not reachable" "is the api up? asf logs api" ;;
  esac

  # Anthropic's terms: a Claude subscription is for its owner's own use. The api flags
  # a subscription token on a multi-operator factory (AUTH_MODE=header); see
  # docs/CLAUDE_USAGE.md. A warning, never a failure.
  res="$(api_check /api/setup/status 'const i=(j.items||[]).find(x=>x.id==="agent-auth"); return i && i.warning ? "WARN|"+i.warning : "OK|"')"
  if [ "${res%%|*}" = "WARN" ]; then
    warn "agent auth: ${res#*|}" "use a Claude API key, Vertex or Bedrock for a shared factory (docs/CLAUDE_USAGE.md)"
  fi

  doctor_ollama

  if [ "$HOST_WORKER_MODE" -eq 1 ]; then
    section "Host worker"
    if [ "$(uname -s)" = "Darwin" ]; then
      if launchctl print "gui/$(id -u)/com.asf.worker" >/dev/null 2>&1; then
        ok "launchd agent com.asf.worker loaded"
      else
        bad "launchd agent com.asf.worker not loaded" "scripts/host-worker.sh up (or scripts/setup.sh --mode 2)"
      fi
    else
      if systemctl --user is-active --quiet asf-worker.service 2>/dev/null; then
        ok "systemd asf-worker.service active"
      else
        bad "systemd asf-worker.service not active" "scripts/host-worker.sh up (or scripts/setup.sh --mode 2)"
      fi
    fi
  fi

  section "Storage"
  local pgsize last
  pgsize="$(compose exec -T postgres du -sh /var/lib/postgresql/data 2>/dev/null | awk '{print $1}')"
  [ -n "$pgsize" ] && info "pgdata volume: ${pgsize}"
  last="$(compose exec -T backup sh -c 'ls -1t /backups/asf-*.sql.gz 2>/dev/null | head -1' 2>/dev/null | tr -d '\r')"
  if [ -n "$last" ]; then ok "last backup: $(basename "$last")"
  else warn "no backups yet" "run: asf backup (the nightly job also writes one)"; fi

  section "Ports"
  local port; port="$(asf_port)"
  if port_in_use "$port"; then
    if [ "$(container_health api)" = "healthy" ] || [ "$(container_health api)" = "running" ]; then
      ok "ASF_PORT ${port} served by the api"
    else
      warn "port ${port} is in use but the api isn't running" "another process holds it; free it or change ASF_PORT"
    fi
  else
    info "ASF_PORT ${port} is free"
  fi

  doctor_summary
}

doctor_summary() {
  section "Summary"
  if [ "$DOCTOR_FAIL" -eq 0 ] && [ "$DOCTOR_WARN" -eq 0 ]; then
    ok "all checks passed"
    return 0
  fi
  if [ "$DOCTOR_FAIL" -eq 0 ]; then
    warn "${DOCTOR_WARN} warning(s) — usable, but see the fixes above"
    return 0
  fi
  bad "${DOCTOR_FAIL} check(s) failed, ${DOCTOR_WARN} warning(s) — fix the ✗ items above"
  return 1
}

# --- dispatch ---------------------------------------------------------------
cmd="${1:-help}"
[ $# -gt 0 ] && shift || true
case "$cmd" in
  up)       cmd_up "$@" ;;
  down)     cmd_down "$@" ;;
  restart)  cmd_restart "$@" ;;
  logs)     cmd_logs "$@" ;;
  status)   cmd_status "$@" ;;
  doctor)   cmd_doctor "$@" ;;
  update)   cmd_update "$@" ;;
  backup)   cmd_backup "$@" ;;
  restore)  cmd_restore "$@" ;;
  secret-key) cmd_secret_key "$@" ;;
  reset)    cmd_reset "$@" ;;
  uninstall) exec "$SCRIPT_DIR/uninstall.sh" "$@" ;;
  open)     cmd_open "$@" ;;
  help|-h|--help) usage ;;
  *) printf 'unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
