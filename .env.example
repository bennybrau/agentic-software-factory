# Generated from packages/shared/src/settings.ts — edit that file, then `pnpm gen:config`.
# Precedence: environment > org settings (UI) > default. Blank means default.
#
# Most keys are optional: the defaults below let the stack boot. Your tracker,
# SCM and agent-auth credentials are set in the UI (Admin), not here.
# For self-hosting, four values matter:
#   RUN_EVENT_SECRET  — shared machine secret; must be identical in registry, api and worker (below)
#   POSTGRES_PASSWORD — database password (docker-compose.self-host.yml var; defaults to asf)
#   ASF_PORT          — host port the UI binds (docker-compose.self-host.yml var; defaults to 8787)
#   AUTH_MODE         — who the operator is: none (single user) or header (behind Tailscale/IAP, records who dispatched)

# --- Registry ---
# Postgres connection. ONLY the registry has this; the api and worker never do. The default is the local docker-compose dev database; in a real deployment point it at a managed instance (or secret://).
DATABASE_URL=postgres://asf:asf@localhost:5432/asf
# Optional search_path. Tests use it to isolate a schema per run.
DATABASE_SCHEMA=
# Apply db/migrations/*.sql at boot (additive-only, checksummed).
DATABASE_MIGRATE=true
# Registry tests; each test file uses its own schema.
DATABASE_TEST_URL=postgres://asf:asf@localhost:5432/asf_test
# Port the registry binds. PORT (Cloud Run) overrides.
REGISTRY_PORT=8788
# Bind address. 127.0.0.1 locally; 0.0.0.0 in a container (set automatically when PORT is present).
REGISTRY_HOST=127.0.0.1
# Where the api and worker reach the registry. The ONE value a shared deployment changes.
REGISTRY_URL=http://127.0.0.1:8788
# Shared machine secret (X-Run-Secret) between registry, api and worker. Must be identical on all three. Generated at boot when blank — fine on one machine, useless across hosts.
RUN_EVENT_SECRET=
# Encrypts tokens saved through Settings (the org_secret table) at rest with AES-256-GCM: 32 random bytes as 64 hex characters (`openssl rand -hex 32`; setup.sh and `asf secret-key` generate it). Registry only — never give it to the api or worker. Back it up separately from the database: a restore without it loses every saved token. Blank = tokens stay plaintext and doctor warns.
ASF_SECRET_KEY=
# Key rotation: the OLD ASF_SECRET_KEY. At boot the registry re-encrypts every saved token from this key to ASF_SECRET_KEY; remove it once doctor shows all tokens on the new key.
ASF_SECRET_KEY_PREVIOUS=
# Minutes of silence before a running run is marked stale (resumable). (also editable in the UI)
STALE_AFTER_MIN=15
# Seconds since last heartbeat before a worker is forgotten and its runs staled. (also editable in the UI)
WORKER_TTL_SECONDS=90
# How often the sweeper looks.
RECONCILE_INTERVAL_MS=60000
# run_events older than this are pruned. agent_run is kept forever by design. (also editable in the UI)
EVENT_RETENTION_DAYS=90

# --- API ---
# Port the api binds. PORT (Cloud Run) overrides.
API_PORT=8787
# Bind address; 0.0.0.0 in a container (automatic when PORT is present).
API_HOST=127.0.0.1
# Where the worker reaches the api (alias BFF_URL).
API_URL=http://127.0.0.1:8787
# Alias of API_URL (takes precedence when set).
BFF_URL=
# Serve the built web bundle from this directory at /. Blank = the Vite dev server serves it (pnpm dev).
WEB_DIST=
# Whether the api runs the work-queue scheduler that turns queued tickets into runs. Off = the queue only records intent. (also editable in the UI)
QUEUE_ENABLED=true
# How often the work-queue scheduler looks for entries ready to dispatch.
QUEUE_TICK_MS=5000
# Whether the api watches runs that finished awaiting an external merge (merge stage off) and, when a human merges or closes the pull/merge request in the SCM, updates the run and moves the ticket to Done. Off = the run stays "awaiting external merge" until updated by hand. (also editable in the UI)
MERGE_WATCH_ENABLED=true
# How often the api polls the SCM for the state of change requests that runs are awaiting an external merge on.
MERGE_WATCH_POLL_MS=60000
# How often the api re-tests the tracker and source-control credentials and checks the age of a UI-saved Claude subscription token, so Settings warns before a run fails. Loading Settings also re-checks, at most every 30s.
CREDENTIAL_CHECK_MS=21600000
# Most files one ad-hoc task (New task, no tracker ticket) may carry. Images, plain text and PDF only.
ADHOC_MAX_ATTACHMENTS=10
# Largest single ad-hoc task attachment, in MB. With ADHOC_MAX_ATTACHMENTS it also sizes the request body limit on the upload route and the registry RPC.
ADHOC_MAX_ATTACHMENT_MB=10
# Largest single crew picture, in MB. Pictures (PNG, JPEG, GIF or WebP, one per crew member) are uploaded in Settings → Crew pictures, alone or as a theme pack zip; see docs/THEMES.md. Also sizes the request body limit on the upload routes and the registry RPC.
AVATAR_MAX_MB=5
# Self-host only: a supervisor sidecar holding the Docker socket can start (or restart) the stopped compose worker container, so /setup and /workers offer a "Start a worker" button. Set by docker-compose.self-host.yml; off everywhere else.
ASF_LOCAL_SUPERVISOR=false
# Where the api reaches the supervisor sidecar (only used when ASF_LOCAL_SUPERVISOR is on). Never published outside the compose network.
SUPERVISOR_URL=http://supervisor:8791

# --- Appearance ---
# How the agent crew looks and talks on the run page: a built-in theme (classic, hive) or the id of an uploaded one. Picked in Settings ("How should the factory look?"). An id that does not exist falls back to classic. (also editable in the UI)
THEME=classic

# --- Updates ---
# Check once a day whether a newer ASF release (a vX.Y.Z image tag) is published. Anonymous and read-only: it only lists the tags of UPDATE_IMAGE_REPO. Nothing is installed; see docs/UPGRADING.md. (also editable in the UI)
UPDATE_CHECK_ENABLED=true
# The image whose tags the update check reads (registry host / name). Point it at your own mirror if you publish ASF images elsewhere.
UPDATE_IMAGE_REPO=ghcr.io/bennybrau/asf-api

# --- Providers ---
# Which work tracker the backlog comes from. One implementation file per value under apps/api/src/providers/tickets/. Org-settable so the operator picks the tracker in Settings ("Where do your tickets live?") and it hot-swaps without a restart. [mock | jira | github | gitlab | trello | monday | linear | todoist] (also editable in the UI)
TICKET_PROVIDER=mock
# Which source-control system holds the repos and receives the pull/merge request. One implementation file per value under apps/api/src/providers/scm/. Org-settable so the operator picks it in Settings ("Where does your code live?") and it hot-swaps without a restart. [mock | github | gitlab] (also editable in the UI)
SCM_PROVIDER=mock
# mock SCM only (development and tests): a local git repo the worker clones. Blank = no repository, so nothing can start until real source control is connected. (also editable in the UI)
MOCK_REPO_PATH=
# Jira: https://<org>.atlassian.net (also editable in the UI)
JIRA_BASE_URL=
# Jira: the account the API token belongs to. (also editable in the UI)
JIRA_EMAIL=
# Jira: API token (id.atlassian.com → Security → API tokens). (also editable in the UI)
JIRA_API_TOKEN=
# Jira: comma-separated project keys the backlog shows. (also editable in the UI)
JIRA_PROJECTS=
# Jira: JQL that scopes the backlog. {{projects}} expands to the quoted JIRA_PROJECTS keys. Must be bounded — Jira rejects an unrestricted query. Omit {{projects}} to write your own filter. (also editable in the UI)
JIRA_JQL_TEMPLATE=project in ({{projects}}) ORDER BY updated DESC
# Jira: comma-separated status=bucket rules mapping a raw status name to a bucket (e.g. "In Progress=inflight,In Review=review"). First matching rule wins; unmatched statuses fall back to the issue statusCategory (new→backlog, indeterminate→inflight, done→done). (also editable in the UI)
JIRA_BUCKET_MAP=
# Jira: comma-separated Agile board ids that make up the backlog scope. When set, the provider reads the boards' issues over the Agile API (scoped to each board's saved filter and paginated in Jira) instead of pulling a whole project — the way to avoid loading all of a large project. When empty, it falls back to the JIRA_PROJECTS / JIRA_JQL_TEMPLATE path. (also editable in the UI)
JIRA_BOARDS=
# Jira: optional named groups of boards for the Team shortcut in the backlog UI, e.g. "payments=42,43; identity=51". Purely a grouping of JIRA_BOARDS ids — no Jira Team field is read. (also editable in the UI)
JIRA_TEAMS=
# GitHub: fine-grained PAT or App token; repo + issues scopes. (also editable in the UI)
GITHUB_TOKEN=
# GitHub: comma-separated owner/repo the backlog and repo picker cover. (also editable in the UI)
GITHUB_REPOS=
# GitHub: comma-separated label=bucket rules mapping issue labels to a bucket (e.g. "status:in progress=inflight,status:review=review"). First matching rule wins; unmatched open issues fall to backlog, closed to done. (also editable in the UI)
GITHUB_BUCKET_MAP=
# GitHub REST/GraphQL API base (change for GitHub Enterprise Server). (also editable in the UI)
GITHUB_API_URL=https://api.github.com
# Trello: API key (trello.com/app-key). Paired with TRELLO_TOKEN as ?key=&token= query auth. (also editable in the UI)
TRELLO_KEY=
# Trello: API token generated against the key (trello.com/app-key → Token). (also editable in the UI)
TRELLO_TOKEN=
# Trello: comma-separated board ids the backlog covers. (also editable in the UI)
TRELLO_BOARDS=
# Trello: comma-separated listName=bucket rules mapping a card's list to a bucket (e.g. "Doing=inflight,Review=review"). First matching rule wins; unmatched cards fall back to a position heuristic (first list→backlog, last→done, else inflight). (also editable in the UI)
TRELLO_LIST_BUCKET_MAP=
# GitLab instance base URL (self-managed or gitlab.com). (also editable in the UI)
GITLAB_BASE_URL=https://gitlab.com
# GitLab: PAT with api scope (Developer+ on the target projects). (also editable in the UI)
GITLAB_TOKEN=
# GitLab: comma-separated group/repo (path_with_namespace) the backlog and repo picker cover. (also editable in the UI)
GITLAB_REPOS=

# --- Ticket workflow ---
# Comma-separated status/transition names (synonyms) the ticket moves to when a run is dispatched. Matched case-insensitively against the tracker's live transitions by name or destination status; first match wins. No match = the ticket is left where it is (not an error). Blank = disable this move. (also editable in the UI)
TICKET_STATUS_INPROGRESS=In Progress,In Development,Doing,inflight
# Comma-separated status/transition names the ticket moves to when the pull/merge request opens. Same matching rule as TICKET_STATUS_INPROGRESS. Blank = disable. (also editable in the UI)
TICKET_STATUS_INREVIEW=In Review,Code Review,Review,review
# Comma-separated status/transition names the ticket moves to when the change request merges. Same matching rule as TICKET_STATUS_INPROGRESS. Blank = disable. (also editable in the UI)
TICKET_STATUS_DONE=Done,Closed,Resolved,Complete,done
# The identity the factory assigns a ticket to on dispatch — its own bot/service account, so the board shows the factory owns the work. Jira: the accountId (id.atlassian.com → the account's profile; NOT the display name or email). GitHub: the bot account login. Blank = leave the assignee unchanged. (also editable in the UI)
TICKET_ASSIGNEE=

# --- Notifications ---
# Comma-separated notification sinks. "web" (the in-app inbox) is always on. Add "telegram" to also push gate/needs-human/finished/failed notifications to a Telegram chat. (also editable in the UI)
NOTIFY_SINKS=web
# Public base URL of the web UI (e.g. https://asf.example.com). Prepended to a notification's in-app deep link so an external sink like Telegram can link straight to the run/gate. Blank = links are sent as relative #/ fragments. (also editable in the UI)
WEB_BASE_URL=
# Telegram Bot API token (from @BotFather) for the telegram sink. Required when NOTIFY_SINKS includes telegram.
TELEGRAM_BOT_TOKEN=
# Telegram chat id the bot posts notifications to (a user, group, or channel id). Required when NOTIFY_SINKS includes telegram. (also editable in the UI)
TELEGRAM_CHAT_ID=
# How often the api looks for undelivered notifications to push to external sinks.
NOTIFY_POLL_MS=5000

# --- Identity ---
# Who the operator is. none = single operator, a name box, badge says unverified. header = trust an upstream proxy (IAP, Tailscale, your SSO) that sets AUTH_HEADER; honoured only when the api is not reachable directly. [none | header]
AUTH_MODE=none
# header mode: the request header carrying the user identity (IAP: X-Goog-Authenticated-User-Email; Tailscale: Tailscale-User-Login).
AUTH_HEADER=X-Goog-Authenticated-User-Email
# Where secret:// values in settings are resolved from. env = the value is literal; file = SECRETS_DIR/<name>; gcp = Secret Manager; aws = Secrets Manager. [env | file | gcp | aws]
SECRETS_SOURCE=env
# file mode: directory of one-file-per-secret (Docker/K8s secrets).
SECRETS_DIR=/run/secrets

# --- Worker ---
# The headless coding agents this worker offers, comma-separated (claude-code, codex, opencode, copilot). claude-code and codex ship in the worker image; opencode and copilot are offered only when installed AND the worker is a container, since neither blocks out-of-scope writes by itself (docs/RUNTIMES.md). Each is probed and auth-preflighted; the worker advertises the ones that pass (so an AI nobody has connected yet simply isn't offered) and re-checks the rest, so one connected later in Settings comes online without a restart. A worker only claims tasks whose runtime it offers.
AGENT_RUNTIMES=claude-code,codex
# Blank (the default) = this worker offers its runtimes under every provider they can serve that passes its check: claude-code for Claude and, once OLLAMA_BASE_URL or OLLAMA_API_KEY is set, for Ollama too. A comma list (anthropic, openai, openai-compatible, github, ollama) limits it, e.g. AGENT_PROVIDERS=ollama dedicates a GPU box to Ollama tasks only. Tasks are routed by the provider of their model: a task on an Ollama model goes only to a worker offering Ollama, any other only to one offering its runtime under another provider (M11, docs/OLLAMA.md).
AGENT_PROVIDERS=
# Deprecated; leave blank. Older installs have AGENT_RUNTIME=claude-code in .env. It no longer restricts the worker: it only puts that agent first, and the other agents in the image are still offered once connected. To restrict a worker, set AGENT_RUNTIMES.
AGENT_RUNTIME=
# How the agent authenticates. api-key (recommended) = ANTHROPIC_API_KEY (metered; real cost per run; fine for a shared factory). oauth-token (the default, kept for upgrades and host `claude login` workers) = a long-lived Claude subscription token from `claude setup-token` (CLAUDE_CODE_OAUTH_TOKEN; billed to the plan, no per-run cost figure) — for the subscription owner's own, single-operator use only; Anthropic's terms do not allow one subscription to serve several people (see docs/CLAUDE_USAGE.md). vertex = Claude on Google Cloud (Vertex AI) with the worker host’s Google login (Application Default Credentials; docs/VERTEX.md). bedrock = AWS Bedrock with IAM. Org-settable so it can be switched from the UI without a worker restart (an env value still pins it); the api resolves the effective mode + credential per run and the worker applies it on the next task. [oauth-token | api-key | vertex | bedrock] (also editable in the UI)
AGENT_AUTH_MODE=oauth-token
# oauth-token mode. Generate once with `claude setup-token` on any machine with a browser (valid about a year) and enter it here; org-settable (write-only) so it is delivered to the worker per run via the resolved run context, never persisted in the worker. (also editable in the UI)
CLAUDE_CODE_OAUTH_TOKEN=
# api-key mode. Org-settable (write-only) so it can be entered in the UI and delivered to the worker per run via the resolved run context, never persisted in the worker. (also editable in the UI)
ANTHROPIC_API_KEY=
# vertex mode: the Google Cloud project id with the Claude models enabled (Settings → Which AI should do the work? → Claude on Google Cloud). Reaches the worker with each task and on its auth check, so a change applies with no restart; a value in the worker's own env is the fallback. (also editable in the UI)
ANTHROPIC_VERTEX_PROJECT_ID=
# vertex mode: the Vertex AI region, `global` (recommended) or one such as us-east5 where your Claude models are enabled. (also editable in the UI)
CLOUD_ML_REGION=global
# bedrock mode: region.
AWS_REGION=us-east-1
# Path to the Claude Code binary.
CLAUDE_BIN=claude
# Extra CLI args appended to every spawn (space-separated).
CLAUDE_EXTRA_ARGS=
# Path to the OpenAI Codex CLI binary (runtime `codex`).
CODEX_BIN=codex
# Path to the OpenCode binary (runtime `opencode`). Offered only by a containerised worker (docs/RUNTIMES.md).
OPENCODE_BIN=opencode
# Path to the GitHub Copilot CLI binary (runtime `copilot`). Offered only by a containerised worker (docs/RUNTIMES.md).
COPILOT_BIN=copilot
# Codex's own command sandbox. workspace-write = Codex confines commands to the worktree + run dir (macOS seatbelt / Linux bubblewrap). off = no nested sandbox (--dangerously-bypass-approvals-and-sandbox), for a worker that is already sandboxed: bubblewrap cannot create namespaces under Docker's default seccomp profile. Scope is still enforced by the container, the per-task worktree and the post-run guard audit. auto = off inside a container (/.dockerenv or ASF_IN_CONTAINER=1), workspace-write elsewhere. [auto | workspace-write | off]
CODEX_SANDBOX=auto
# Extra `codex exec` args appended to every Codex spawn (space-separated), after ASF's own flags and before the stdin prompt marker.
CODEX_EXTRA_ARGS=
# Stable worker id. Blank = worker-<host>-<pid>.
WORKER_ID=
# This worker’s contribution to fleet capacity.
WORKER_MAX_CONCURRENT=2
# Claude on Google Cloud: how often a worker re-checks its Google login (free; no model call). An expired login stops the worker taking Claude tasks and sends one notification; it resumes on its own once the login works again. Not used for Bedrock or other modes.
AGENT_AUTH_RECHECK_MS=300000
# Claim poll interval.
WORKER_POLL_INTERVAL_MS=3000
# Heartbeat interval; must be well under WORKER_TTL_SECONDS.
WORKER_HEARTBEAT_INTERVAL_MS=30000
# A role still running after this is stuck, not thorough: SIGTERM then SIGKILL. (also editable in the UI)
SEGMENT_TIMEOUT_MS=2700000
# Global default and backstop turn ceiling (--max-turns) so a wedged agent cannot loop until the timeout; a MAX_TURNS_<ROLE> overrides it for that role. 0 = no ceiling. Generous by design; the role prompts do the real trimming. (also editable in the UI)
WORKER_MAX_TURNS=40
# Turn ceiling (--max-turns) for the planner. 0 = use WORKER_MAX_TURNS. (also editable in the UI)
MAX_TURNS_PLANNER=40
# Turn ceiling (--max-turns) for the implementer. 0 = use WORKER_MAX_TURNS. (also editable in the UI)
MAX_TURNS_IMPLEMENTER=150
# Turn ceiling (--max-turns) for the tester. 0 = use WORKER_MAX_TURNS. (also editable in the UI)
MAX_TURNS_TESTER=80
# Turn ceiling (--max-turns) for the reviewer. 0 = use WORKER_MAX_TURNS. (also editable in the UI)
MAX_TURNS_REVIEWER=40
# Run everything, publish nothing: no push, no PR. How to try a run the first time.
WORKER_DRY_RUN=false
# Where repos are cloned and worktrees live. Blank = <tmpdir>/asf-worktrees. Must NOT be a macOS TCC-protected folder for an unattended host.
WORKTREE_ROOT=
# Per-run dir: prompts, transcripts, artifacts. Blank = <tmpdir>/asf-runs.
RUN_DATA_ROOT=

# --- Agent providers ---
# How an OpenAI-backed runtime (Codex) authenticates. api-key = OPENAI_API_KEY (metered). chatgpt = a ChatGPT-plan login already present in the runtime's own home on the worker (no credential travels). [api-key | chatgpt] (also editable in the UI)
AGENT_AUTH_OPENAI_MODE=api-key
# OpenAI api-key mode. Write-only; delivered to the worker per run, never persisted there. (also editable in the UI)
OPENAI_API_KEY=
# Optional OpenAI endpoint override (e.g. an Azure OpenAI or proxy URL). Blank = the runtime default. (also editable in the UI)
OPENAI_BASE_URL=
# How a runtime authenticates to an OpenAI-compatible endpoint (DeepSeek, Qwen, GLM, a local vLLM/llama.cpp server). none = the endpoint takes no key (local servers). [api-key | none] (also editable in the UI)
AGENT_AUTH_OPENAI_COMPAT_MODE=api-key
# OpenAI-compatible api-key mode. Write-only; delivered to the worker per run. (also editable in the UI)
OPENAI_COMPAT_API_KEY=
# The OpenAI-compatible endpoint, e.g. https://api.deepseek.com/v1 or http://host.docker.internal:8080/v1. Required for that provider. (also editable in the UI)
OPENAI_COMPAT_BASE_URL=
# The local or LAN Ollama server for models on the `ollama` provider, e.g. http://host.docker.internal:11434 (container worker) or http://localhost:11434 (host worker). No /v1. Blank = no local server. The server needs a context of at least 64k (OLLAMA_CONTEXT_LENGTH). (also editable in the UI)
OLLAMA_BASE_URL=
# Ollama Cloud key (ollama.com/settings/keys) for models on the `ollama-cloud` provider. Sent only to https://ollama.com, never to a local server. Write-only; delivered to the worker per run. (also editable in the UI)
OLLAMA_API_KEY=
# How a GitHub-backed runtime (Copilot CLI) authenticates. gh-token = GITHUB_COPILOT_TOKEN, a token with Copilot access. [gh-token] (also editable in the UI)
AGENT_AUTH_GITHUB_MODE=gh-token
# GitHub token with Copilot access for gh-token mode. Separate from the SCM token on purpose (different scope, different owner). Write-only; delivered per run. (also editable in the UI)
GITHUB_COPILOT_TOKEN=

# --- Models & budget ---
# Model the planner runs with unless the dispatch overrides it. Must be a model id in the catalogue (built-in or MODEL_CATALOG_EXTRA), on MODEL_ALLOWLIST when one is set, that its runtime can drive; checked at dispatch. (also editable in the UI)
MODEL_DEFAULT_PLANNER=claude-opus-4-8
# Model the implementer runs with unless the dispatch overrides it. Must be a model id in the catalogue (built-in or MODEL_CATALOG_EXTRA), on MODEL_ALLOWLIST when one is set, that its runtime can drive; checked at dispatch. (also editable in the UI)
MODEL_DEFAULT_IMPLEMENTER=claude-opus-4-8
# Model the tester runs with unless the dispatch overrides it. Must be a model id in the catalogue (built-in or MODEL_CATALOG_EXTRA), on MODEL_ALLOWLIST when one is set, that its runtime can drive; checked at dispatch. (also editable in the UI)
MODEL_DEFAULT_TESTER=claude-sonnet-5
# Model the reviewer runs with unless the dispatch overrides it. Must be a model id in the catalogue (built-in or MODEL_CATALOG_EXTRA), on MODEL_ALLOWLIST when one is set, that its runtime can drive; checked at dispatch. (also editable in the UI)
MODEL_DEFAULT_REVIEWER=claude-sonnet-5
# Agent runtime the planner runs on unless the dispatch overrides it (claude-code, codex, …). (also editable in the UI)
RUNTIME_DEFAULT_PLANNER=claude-code
# Agent runtime the implementer runs on unless the dispatch overrides it (claude-code, codex, …). (also editable in the UI)
RUNTIME_DEFAULT_IMPLEMENTER=claude-code
# Agent runtime the tester runs on unless the dispatch overrides it (claude-code, codex, …). (also editable in the UI)
RUNTIME_DEFAULT_TESTER=claude-code
# Agent runtime the reviewer runs on unless the dispatch overrides it (claude-code, codex, …). (also editable in the UI)
RUNTIME_DEFAULT_REVIEWER=claude-code
# Comma-separated model ids this factory may run (blank = every catalogue model). On Vertex AI or Bedrock, list only the models enabled on your cloud project so a dispatch never offers one that would fail. Add provider-specific ids (claude-haiku-4-5@20251001, claude-sonnet-5[1m]) to MODEL_CATALOG_EXTRA first; an id in neither the built-ins nor MODEL_CATALOG_EXTRA is ignored. A role whose default model is hidden falls back to an allowed model of the same tier. [1m] ids price at the base rate (the long-context premium above 200K input tokens is not counted). Applies on the next dispatch, no restart. (also editable in the UI)
MODEL_ALLOWLIST=
# Reasoning effort the planner runs with unless the dispatch overrides it. [low | medium | high | xhigh | max] (also editable in the UI)
EFFORT_DEFAULT_PLANNER=high
# Reasoning effort the implementer runs with unless the dispatch overrides it. [low | medium | high | xhigh | max] (also editable in the UI)
EFFORT_DEFAULT_IMPLEMENTER=high
# Reasoning effort the tester runs with unless the dispatch overrides it. [low | medium | high | xhigh | max] (also editable in the UI)
EFFORT_DEFAULT_TESTER=low
# Reasoning effort the reviewer runs with unless the dispatch overrides it. [low | medium | high | xhigh | max] (also editable in the UI)
EFFORT_DEFAULT_REVIEWER=medium
# Hard per-run cap. A dispatch asking for more is refused with a reason. (also editable in the UI)
ORG_MAX_COST_USD=25
# Dispatch refuses once this calendar month’s summed run cost passes it. 0 = no budget. (also editable in the UI)
ORG_MONTHLY_BUDGET_USD=0

# --- Role skills ---
# Standing guidance appended to the planner’s prompt on every dispatch. Blank = none. Appended below the shipped role template; the ticket and approved plan still take precedence. (also editable in the UI)
ROLE_SKILL_PLANNER=
# Standing guidance appended to the implementer’s prompt on every dispatch. Blank = none. Appended below the shipped role template; the ticket and approved plan still take precedence. (also editable in the UI)
ROLE_SKILL_IMPLEMENTER=
# Standing guidance appended to the tester’s prompt on every dispatch. Blank = none. Appended below the shipped role template; the ticket and approved plan still take precedence. (also editable in the UI)
ROLE_SKILL_TESTER=
# Standing guidance appended to the reviewer’s prompt on every dispatch. Blank = none. Appended below the shipped role template; the ticket and approved plan still take precedence. (also editable in the UI)
ROLE_SKILL_REVIEWER=

# --- Policy ---
# When on (default), the orchestrator stops the reviewer↔implementer loop early if a review repeats the previous review’s blocking findings and the changes did not resolve them, parking at a needs-human checkpoint instead of burning another cycle.
LOOP_REPEAT_DETECT=true

# --- Misc ---
# pino log level. [trace | debug | info | warn | error]
LOG_LEVEL=info
